---
import Icon from "blume/components/Icon.astro";
import RootLayout from "blume/components/layout/RootLayout.astro";
import { withBase } from "blume/components/islands/base-path.ts";
import data from "blume:data";
import LandingHeader from "../components/LandingHeader.astro";
import LinuxTux from "../components/LinuxTux.astro";
import Search from "../components/Search.astro";

const { config } = data;
const description =
  "Lucent is a cross-platform automation utility client for AdventureQuest Worlds.";
const releasesUrl = "https://github.com/toommyliu/lucent/releases";
const latestReleaseUrl = `${releasesUrl}/latest`;
const latestAssetsUrl = `${latestReleaseUrl}#assets`;
const guidesUrl = withBase("/guides");
const iconUrl = withBase("/icon.svg");
const overviewScreenshotUrl = withBase("/screenshots/lucent-overview.webp");
const workspaceScreenshotUrl = withBase("/screenshots/lucent-workspace.png");
const accountManagerScreenshotUrl = withBase("/screenshots/account-manager.webp");
const overviewScreenshotAlt =
  "Lucent with tabbed accounts, mixed rendering modes, and group controls open";
const workspaceScreenshotAlt =
  "Lucent running AQW alongside the Combat Profiles and Environment windows, with a Relic of Chaos drop ready to accept";
const galleryItems = [
  {
    alt: overviewScreenshotAlt,
    label: "Tabbed windows",
    src: overviewScreenshotUrl,
  },
  {
    alt: workspaceScreenshotAlt,
    label: "Automation workspace",
    src: workspaceScreenshotUrl,
  },
  {
    alt: overviewScreenshotAlt,
    label: "Account manager",
    src: accountManagerScreenshotUrl,
  },
  {
    alt: overviewScreenshotAlt,
    label: "Minimal rendering",
    src: overviewScreenshotUrl,
  },
] as const;
const layout = { Header: LandingHeader, Search };
const siteBase = config.site?.replace(/\/$/u, "") ?? null;
const rootPath = withBase("/");
const canonical =
  siteBase === null
    ? null
    : `${siteBase}${rootPath === "/" ? "" : rootPath}`;
const ogImage =
  config.og.enabled && siteBase
    ? `${siteBase}${withBase("/og/index.png")}`
    : null;
---

<RootLayout
  analytics={config.analytics}
  appleIcon={config.appleIcon}
  banner={config.banner}
  canonical={canonical}
  contentLayout="bare"
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  headings={[]}
  indexable
  layout={layout}
  logo={config.logo}
  navigation={data.navigation}
  ogGenerated={Boolean(ogImage)}
  ogImage={ogImage}
  page={{ title: "", description, route: "/" }}
  searchEnabled={config.search.enabled}
  site={{ title: config.title, description: config.description }}
  siteUrl={config.site}
  structuredDataEnabled={false}
  themeMode={config.theme.mode}
  toc={config.toc}
  ui={data.ui}
>
  <section class="not-prose" id="lucent-landing">
    <div class="landing-hero">
      <div class="landing-lockup">
        <img
          alt=""
          aria-hidden="true"
          draggable="false"
          height="40"
          src={iconUrl}
          width="40"
        />
        <span>Lucent</span>
      </div>

      <h1>Automation for the rest of us.</h1>
      <p class="landing-intro">
        AQW automation for macOS, Windows, and Linux.
      </p>

      <div class="landing-actions">
        <lucent-download-menu
          class="landing-download-group"
          data-platform-preview-enabled={import.meta.env.DEV ? "" : undefined}
        >
          <a
            aria-describedby="download-note"
            aria-label="Download Lucent"
            class="landing-download"
            href={latestAssetsUrl}
            rel="noreferrer"
            target="_blank"
          >
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="mac"
            >
              <svg fill="currentColor" viewBox="0 0 814 1000">
                <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"></path>
              </svg>
            </span>
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="windows"
            >
              <svg fill="currentColor" viewBox="0 0 88 88">
                <path d="M0 0h42v42H0zm46 0h42v42H46zM0 46h42v42H0zm46 0h42v42H46z"></path>
              </svg>
            </span>
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="linux"
            >
              <LinuxTux />
            </span>
            <span class="landing-download-label">
              <span data-landing-download-label>Download Lucent</span>
              <span aria-hidden="true" class="landing-download-label-compact">
                Download
              </span>
            </span>
          </a>
          <details data-landing-download-menu>
            <summary aria-label="Choose a download">
              <Icon name="chevron-down" size={16} />
            </summary>
            <div class="landing-download-menu">
              <p>Choose the matching file</p>
              <a href={latestAssetsUrl} rel="noreferrer" target="_blank">
                <span>macOS</span>
                <span>DMG</span>
              </a>
              <a href={latestAssetsUrl} rel="noreferrer" target="_blank">
                <span>Windows</span>
                <span>ZIP</span>
              </a>
              <a href={latestAssetsUrl} rel="noreferrer" target="_blank">
                <span>Linux</span>
                <span>AppImage</span>
              </a>
              <a href={releasesUrl} rel="noreferrer" target="_blank">
                <span>All releases</span>
                <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </details>
          <script is:inline>
            (() => {
              const menu = document.currentScript?.closest("lucent-download-menu");
              const label = menu?.querySelector("[data-landing-download-label]");
              if (label === null || label === undefined) return;

              const preview = menu.hasAttribute("data-platform-preview-enabled")
                ? new URLSearchParams(window.location.search)
                    .get("platform")
                    ?.toLowerCase()
                : null;
              const userAgent = navigator.userAgent.toLowerCase();
              const platform =
                navigator.userAgentData?.platform?.toLowerCase() ?? userAgent;
              const mobile =
                /android|iphone|ipad|ipod/u.test(userAgent) ||
                (userAgent.includes("macintosh") && navigator.maxTouchPoints > 1);

              const detected = mobile
                ? null
                : platform.includes("windows")
                  ? "windows"
                  : platform.includes("mac")
                    ? "mac"
                    : platform.includes("linux")
                      ? "linux"
                      : null;
              const selected = ["mac", "windows", "linux"].includes(preview)
                ? preview
                : detected;
              const labels = { mac: "Mac", windows: "Windows", linux: "Linux" };
              const name = selected === null ? null : labels[selected];

              if (name !== null) {
                menu.dataset.downloadPlatform = selected;
                label.textContent = `Download for ${name}`;
                menu
                  .querySelector(".landing-download")
                  ?.setAttribute("aria-label", `Download Lucent for ${name}`);
              }
            })();
          </script>
        </lucent-download-menu>

        <a class="landing-secondary" href={guidesUrl}>
          <span>Read the docs</span>
          <Icon aria-hidden="true" name="arrow-right" size={16} />
        </a>
      </div>

      <p class="landing-note" id="download-note">
        <span>Unofficial client. Use at your own risk.</span>
      </p>
    </div>

    <lucent-product-gallery
      aria-label="Lucent product gallery"
      class="landing-gallery"
    >
      <div class="landing-gallery-frame">
        <img
          alt={galleryItems[0].alt}
          data-gallery-image
          data-no-zoom
          decoding="async"
          draggable="false"
          height="942"
          id="gallery-image"
          loading="eager"
          src={galleryItems[0].src}
          width="1392"
        />
      </div>

      <div
        aria-label="Choose a product view"
        class="landing-gallery-selector"
        data-gallery-active="0"
        data-gallery-selector
        role="group"
      >
        {
          galleryItems.map((item, index) => (
            <button
              aria-controls="gallery-image"
              aria-label={`Show ${item.label}`}
              aria-pressed={index === 0 ? "true" : "false"}
              data-gallery-alt={item.alt}
              data-gallery-index={index}
              data-gallery-src={item.src}
              tabindex={index === 0 ? 0 : -1}
              type="button"
            >
              <span class="sr-only">{item.label}</span>
            </button>
          ))
        }
      </div>
    </lucent-product-gallery>

    <section aria-labelledby="faq-heading" class="landing-faq">
      <h2 id="faq-heading">More about Lucent</h2>
      <div class="landing-faq-list">
        <details>
          <summary>
            <span>Is Lucent for me?</span>
            <Icon
              aria-hidden="true"
              class="landing-faq-icon"
              name="chevron-down"
              size={16}
            />
          </summary>
          <div class="landing-faq-answer">
            <p>
              Lucent is a smaller, mostly DIY toolkit. Skua or Grimlite may
              better satisfy your needs if you want similar scripting
              flexibility with a richer ecosystem and more ready-made scripts.
            </p>
          </div>
        </details>
      </div>
    </section>
  </section>
</RootLayout>

<style is:global>
  #lucent-landing {
    position: relative;
    width: min(72rem, calc(100vw - 1.5rem));
    margin-inline-start: 50%;
    padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 4rem);
    color: var(--color-foreground);
    transform: translateX(-50%);
  }

  #lucent-landing a {
    text-decoration: none;
  }

  #lucent-landing .landing-hero {
    position: relative;
    z-index: 10;
    max-width: 40rem;
  }

  #lucent-landing .landing-lockup {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  #lucent-landing .landing-lockup img {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    pointer-events: none;
    user-select: none;
  }

  #lucent-landing h1 {
    max-width: 20ch;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }

  #lucent-landing .landing-intro {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    color: var(--color-muted-foreground);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  #lucent-landing .landing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  #lucent-landing .landing-download-group {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: stretch;
    border-radius: 9999px;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  #lucent-landing .landing-download {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    border-radius: 9999px 0 0 9999px;
    padding-inline: 1.25rem 0.7rem;
    color: var(--color-background);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  #lucent-landing .landing-download-label-compact {
    display: none;
  }

  #lucent-landing .landing-platform-icon {
    display: none;
    width: 1.1875rem;
    height: 1.1875rem;
    flex: 0 0 1.1875rem;
    align-items: center;
    justify-content: center;
  }

  #lucent-landing .landing-platform-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #lucent-landing
    .landing-download-group[data-download-platform="mac"]
    [data-platform-icon="mac"],
  #lucent-landing
    .landing-download-group[data-download-platform="windows"]
    [data-platform-icon="windows"],
  #lucent-landing
    .landing-download-group[data-download-platform="linux"]
    [data-platform-icon="linux"] {
    display: inline-flex;
  }

  #lucent-landing .landing-download-group details {
    position: static;
  }

  #lucent-landing .landing-download-group summary {
    position: relative;
    display: inline-flex;
    min-width: 2.75rem;
    height: 100%;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: center;
    border-radius: 0 9999px 9999px 0;
    padding-inline: 0.5rem 0.75rem;
  }

  #lucent-landing .landing-download-group summary::before {
    position: absolute;
    inset-block: 0.65rem;
    inset-inline-start: 0;
    width: 1px;
    background: color-mix(in oklab, currentColor 14%, transparent);
    content: "";
  }

  #lucent-landing .landing-download-group summary::-webkit-details-marker {
    display: none;
  }

  #lucent-landing .landing-download-group details[open] summary svg {
    transform: rotate(180deg);
  }

  #lucent-landing .landing-download-group summary svg {
    opacity: 0.5;
  }

  #lucent-landing .landing-download-menu {
    position: absolute;
    z-index: 50;
    top: calc(100% + 0.625rem);
    inset-inline-end: 0;
    display: grid;
    width: 14rem;
    gap: 0.125rem;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-background);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.08),
      0 16px 36px oklch(0 0 0 / 0.14);
    color: var(--color-foreground);
  }

  #lucent-landing .landing-download-menu p {
    margin: 0;
    padding: 0.375rem 0.625rem 0.25rem;
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  #lucent-landing .landing-download-menu a {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.625rem;
    padding-inline: 0.625rem;
    color: var(--color-foreground);
    font-size: 0.875rem;
  }

  #lucent-landing .landing-download-menu a > :last-child {
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
  }

  #lucent-landing .landing-secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 9999px;
    padding-inline: 1.25rem;
    background: var(--color-muted);
    color: var(--color-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  #lucent-landing .landing-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  #lucent-landing .landing-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: auto;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.18em;
    text-underline-position: from-font;
  }

  #lucent-landing .landing-gallery {
    display: block;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  #lucent-landing .landing-gallery-frame {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-muted);
    isolation: isolate;
  }

  #lucent-landing .landing-gallery-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1392 / 942;
    object-fit: cover;
    user-select: none;
  }

  #lucent-landing .landing-gallery-selector {
    --gallery-index: 0;
    position: relative;
    display: flex;
    width: 10.375rem;
    justify-content: center;
    gap: 0.125rem;
    margin: 0.75rem auto 0;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="1"] {
    --gallery-index: 1;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="2"] {
    --gallery-index: 2;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="3"] {
    --gallery-index: 3;
  }

  #lucent-landing .landing-gallery-selector::after {
    position: absolute;
    top: 1rem;
    inset-inline-start: 0.5rem;
    width: 1.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-foreground);
    content: "";
    pointer-events: none;
    transform: translateX(calc(var(--gallery-index) * 2.625rem));
  }

  #lucent-landing .landing-gallery-selector button {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    padding: 0;
    background: transparent;
    color: var(--color-muted-foreground);
  }

  #lucent-landing .landing-gallery-selector button::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
    content: "";
    opacity: 0.45;
  }

  #lucent-landing
    .landing-gallery-selector
    button[aria-pressed="true"]::before {
    opacity: 0;
  }

  #lucent-landing .landing-faq {
    max-width: 48rem;
    margin: clamp(2.5rem, 4vw, 3.5rem) auto 0;
  }

  #lucent-landing .landing-faq > h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  #lucent-landing .landing-faq-list {
    overflow: hidden;
    margin-top: 1rem;
    border-radius: 0.875rem;
    background: color-mix(in oklab, var(--color-muted) 60%, transparent);
  }

  #lucent-landing .landing-faq summary {
    display: flex;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  #lucent-landing .landing-faq summary::-webkit-details-marker {
    display: none;
  }

  #lucent-landing .landing-faq details[open] .landing-faq-icon {
    transform: rotate(180deg);
  }

  #lucent-landing .landing-faq-icon {
    flex: 0 0 auto;
    color: var(--color-muted-foreground);
  }

  #lucent-landing .landing-faq-answer {
    padding: 0 1rem 1rem;
  }

  #lucent-landing .landing-faq-answer p {
    max-width: 65ch;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  #lucent-landing
    :is(
      .landing-download,
      .landing-download-group summary,
      .landing-secondary,
      .landing-faq summary,
      .landing-gallery-selector button
    ):focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    #lucent-landing .landing-download-group > a:hover,
    #lucent-landing .landing-download-group > details > summary:hover,
    #lucent-landing .landing-download-group > details[open] > summary {
      background: color-mix(
        in oklab,
        var(--color-background) 14%,
        transparent
      );
    }

    #lucent-landing .landing-download-menu a:hover,
    #lucent-landing .landing-secondary:hover {
      background: color-mix(
        in oklab,
        var(--color-muted) 84%,
        var(--color-foreground) 16%
      );
    }

    #lucent-landing .landing-gallery-selector button:hover::before {
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes landing-enter {
      from {
        opacity: 0;
        transform: translateY(0.375rem);
      }
    }

    #lucent-landing
      :is(
        .landing-lockup,
        h1,
        .landing-intro,
        .landing-actions,
        .landing-note,
        .landing-gallery
      ) {
      animation: landing-enter 400ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    #lucent-landing h1 {
      animation-delay: 50ms;
    }

    #lucent-landing .landing-intro {
      animation-delay: 100ms;
    }

    #lucent-landing .landing-actions {
      animation-delay: 150ms;
    }

    #lucent-landing .landing-note {
      animation-delay: 190ms;
    }

    #lucent-landing .landing-gallery {
      animation-delay: 230ms;
    }

    #lucent-landing .landing-download-group > a,
    #lucent-landing .landing-download-group > details > summary,
    #lucent-landing .landing-download-menu a,
    #lucent-landing .landing-secondary {
      transition: background-color 150ms ease;
    }

    #lucent-landing .landing-download-group summary svg {
      transition:
        opacity 150ms ease,
        transform 150ms ease;
    }

    #lucent-landing .landing-gallery-selector button {
      transition: scale 150ms ease;
    }

    #lucent-landing .landing-gallery-selector button::before {
      transition: opacity 150ms ease;
    }

    #lucent-landing .landing-gallery-selector::after {
      transition: transform 250ms cubic-bezier(0.2, 0, 0, 1);
    }

    #lucent-landing .landing-faq-icon {
      transition: transform 150ms ease;
    }

    #lucent-landing
      :is(
        .landing-download,
        .landing-download-group summary,
        .landing-secondary,
        .landing-gallery-selector button
      ):active {
      scale: 0.96;
    }
  }

  @media (min-width: 40rem) {
    #lucent-landing {
      width: min(72rem, calc(100vw - 2.5rem));
    }
  }

  @media (max-width: 42.499rem) {
    #lucent-landing .landing-download-menu {
      inset-inline-start: 0;
      inset-inline-end: auto;
    }

    #lucent-landing .landing-download-label > [data-landing-download-label] {
      display: none;
    }

    #lucent-landing .landing-download-label-compact {
      display: inline;
    }
  }

  @media (max-width: 31.999rem) {
    #lucent-landing h1 {
      font-size: clamp(2rem, 10vw, 2.6rem);
    }

    #lucent-landing .landing-actions {
      align-items: stretch;
    }

    #lucent-landing .landing-download-group,
    #lucent-landing .landing-secondary {
      flex-grow: 1;
    }

    #lucent-landing .landing-download {
      flex: 1;
      justify-content: center;
    }

    #lucent-landing .landing-gallery-frame {
      border-radius: 0.875rem;
    }
  }
</style>

<script>
  class LucentDownloadMenu extends HTMLElement {
    #details: HTMLDetailsElement | null = null;

    #onDocumentClick = (event: MouseEvent): void => {
      if (
        this.#details?.open === true &&
        event.target instanceof Node &&
        !this.contains(event.target)
      ) {
        this.#details.open = false;
      }
    };

    #onDocumentKeydown = (event: KeyboardEvent): void => {
      if (event.key === "Escape" && this.#details?.open === true) {
        this.#details.open = false;
        this.#details.querySelector("summary")?.focus();
      }
    };

    connectedCallback(): void {
      this.#details = this.querySelector("[data-landing-download-menu]");
      document.addEventListener("click", this.#onDocumentClick);
      document.addEventListener("keydown", this.#onDocumentKeydown);
    }

    disconnectedCallback(): void {
      document.removeEventListener("click", this.#onDocumentClick);
      document.removeEventListener("keydown", this.#onDocumentKeydown);
      this.#details = null;
    }
  }

  class LucentProductGallery extends HTMLElement {
    #buttons: HTMLButtonElement[] = [];
    #image: HTMLImageElement | null = null;
    #imageRequest = 0;
    #selector: HTMLElement | null = null;

    #onClick = (event: MouseEvent): void => {
      if (!(event.target instanceof Element)) return;

      const button = event.target.closest<HTMLButtonElement>(
        "[data-gallery-index]",
      );
      if (button === null || !this.contains(button)) return;

      this.#select(Number(button.dataset.galleryIndex));
    };

    #onKeydown = (event: KeyboardEvent): void => {
      if (!(event.target instanceof HTMLButtonElement)) return;

      const current = this.#buttons.indexOf(event.target);
      if (current === -1) return;

      const last = this.#buttons.length - 1;
      const next =
        event.key === "ArrowRight"
          ? current === last
            ? 0
            : current + 1
          : event.key === "ArrowLeft"
            ? current === 0
              ? last
              : current - 1
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? last
                : null;

      if (next === null) return;

      event.preventDefault();
      this.#select(next, true);
    };

    #select(index: number, focus = false): void {
      const selected = this.#buttons[index];
      if (selected === undefined) return;

      this.#buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === index;
        button.setAttribute("aria-pressed", String(active));
        button.tabIndex = active ? 0 : -1;
      });

      if (this.#selector !== null) {
        this.#selector.dataset.galleryActive = String(index);
      }

      this.#showImage(selected);

      if (focus) selected.focus();
    }

    #showImage(selected: HTMLButtonElement): void {
      const image = this.#image;
      const src = selected.dataset.gallerySrc;
      if (image === null || src === undefined) return;

      const alt = selected.dataset.galleryAlt ?? "";
      if (image.getAttribute("src") === src) {
        image.alt = alt;
        return;
      }

      const request = ++this.#imageRequest;
      const nextImage = new Image();
      nextImage.src = src;

      void nextImage
        .decode()
        .then(() => {
          if (request !== this.#imageRequest || this.#image === null) return;
          this.#image.src = src;
          this.#image.alt = alt;
        })
        .catch(() => undefined);
    }

    connectedCallback(): void {
      this.#buttons = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-gallery-index]"),
      );
      this.#image = this.querySelector("[data-gallery-image]");
      this.#selector = this.querySelector("[data-gallery-selector]");
      this.addEventListener("click", this.#onClick);
      this.addEventListener("keydown", this.#onKeydown);
    }

    disconnectedCallback(): void {
      this.removeEventListener("click", this.#onClick);
      this.removeEventListener("keydown", this.#onKeydown);
      this.#buttons = [];
      this.#image = null;
      this.#imageRequest += 1;
      this.#selector = null;
    }
  }

  if (!customElements.get("lucent-download-menu")) {
    customElements.define("lucent-download-menu", LucentDownloadMenu);
  }

  if (!customElements.get("lucent-product-gallery")) {
    customElements.define("lucent-product-gallery", LucentProductGallery);
  }
</script>
