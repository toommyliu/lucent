<lucent-sidebar-state-controller hidden></lucent-sidebar-state-controller>

<script>
  // Keep expanded navigation groups open while readers move between pages.
  const SIDEBAR_GROUPS_STORAGE_KEY = "lucent-sidebar-groups";

  const readOpenGroups = (): Set<string> => {
    try {
      const value: unknown = JSON.parse(
        sessionStorage.getItem(SIDEBAR_GROUPS_STORAGE_KEY) ?? "[]",
      );
      return new Set(
        Array.isArray(value)
          ? value.filter((item): item is string => typeof item === "string")
          : [],
      );
    } catch {
      return new Set();
    }
  };

  const writeOpenGroups = (groups: ReadonlySet<string>): void => {
    try {
      sessionStorage.setItem(
        SIDEBAR_GROUPS_STORAGE_KEY,
        JSON.stringify([...groups]),
      );
    } catch {
      // Navigation still works normally when session storage is unavailable.
    }
  };

  const groupKey = (details: HTMLDetailsElement, index: number): string => {
    const firstLink = details.querySelector<HTMLAnchorElement>("a[href]");
    const href = firstLink?.getAttribute("href");
    if (href !== null && href !== undefined) {
      return `href:${href}`;
    }

    const label = details.querySelector("summary")?.textContent?.trim();
    return `label:${label ?? "group"}:${index}`;
  };

  class LucentSidebarStateController extends HTMLElement {
    #boundGroups = new Map<
      HTMLDetailsElement,
      { readonly key: string; readonly onToggle: () => void }
    >();
    #openGroups = readOpenGroups();

    #syncGroup = (
      key: string,
      open: boolean,
      source: HTMLDetailsElement,
    ): void => {
      if (open) {
        this.#openGroups.add(key);
      } else {
        this.#openGroups.delete(key);
      }
      writeOpenGroups(this.#openGroups);

      for (const [details, entry] of this.#boundGroups) {
        if (
          details !== source &&
          entry.key === key &&
          details.open !== open
        ) {
          details.open = open;
        }
      }
    };

    #attachGroups = (): void => {
      const groups = document.querySelectorAll<HTMLDetailsElement>(
        "[data-blume-nav-tree] details",
      );

      groups.forEach((details, index) => {
        if (this.#boundGroups.has(details)) {
          return;
        }

        const key = groupKey(details, index);
        if (details.open) {
          this.#openGroups.add(key);
        } else if (this.#openGroups.has(key)) {
          details.open = true;
        }

        const onToggle = (): void => {
          this.#syncGroup(key, details.open, details);
        };
        details.addEventListener("toggle", onToggle);
        this.#boundGroups.set(details, { key, onToggle });
      });

      writeOpenGroups(this.#openGroups);
    };

    connectedCallback(): void {
      this.#attachGroups();
      document.addEventListener("astro:page-load", this.#attachGroups);
    }

    disconnectedCallback(): void {
      document.removeEventListener("astro:page-load", this.#attachGroups);
      for (const [details, entry] of this.#boundGroups) {
        details.removeEventListener("toggle", entry.onToggle);
      }
      this.#boundGroups.clear();
    }
  }

  if (!customElements.get("lucent-sidebar-state-controller")) {
    customElements.define(
      "lucent-sidebar-state-controller",
      LucentSidebarStateController,
    );
  }
</script>
