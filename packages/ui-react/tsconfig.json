{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "skipDefaultLibCheck": true
  },
  "include": [
    ".storybook/**/*",
    "scripts/**/*",
    "src/**/*",
    "vite.config.ts"
  ]
}
