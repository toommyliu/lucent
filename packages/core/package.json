{
  "name": "@lucent/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js",
      "default": "./dist/appearance.js"
    },
    "./accounts": {
      "types": "./dist/accounts.d.ts",
      "import": "./dist/accounts.js",
      "default": "./dist/accounts.js"
    },
    "./army": {
      "types": "./dist/army.d.ts",
      "import": "./dist/army.js",
      "default": "./dist/army.js"
    },
    "./combatProfiles": {
      "types": "./dist/combatProfiles.d.ts",
      "import": "./dist/combatProfiles.js",
      "default": "./dist/combatProfiles.js"
    },
    "./hotkeys": {
      "types": "./dist/hotkeys.d.ts",
      "import": "./dist/hotkeys.js",
      "default": "./dist/hotkeys.js"
    },
    "./scriptInputs": {
      "types": "./dist/scriptInputs.d.ts",
      "import": "./dist/scriptInputs.js",
      "default": "./dist/scriptInputs.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js",
      "default": "./dist/settings.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-beta.83"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.83",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
